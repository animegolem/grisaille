<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ONE per machine. The managed Codex app-server every relay ear talks
       to over ws://127.0.0.1:45831. If it already exists, do not install a
       second — point new ears at the existing endpoint. -->
  <key>Label</key><string>com.{{OWNER}}.codex.app-server</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/codex</string><string>app-server</string><string>--listen</string><string>ws://127.0.0.1:45831</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>{{HOME}}</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ProcessType</key><string>Background</string><key>ThrottleInterval</key><integer>5</integer>
  <key>WorkingDirectory</key><string>{{HOME}}</string>
  <key>StandardOutPath</key><string>{{HOME}}/.codex/app-server/stdout.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/.codex/app-server/stderr.log</string>
</dict></plist>
